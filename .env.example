# Copy to .env.local and edit. All variables are optional.

# --- server ---
CLAUDE_LB_HOST=127.0.0.1
CLAUDE_LB_PORT=2456
CLAUDE_LB_LOG_LEVEL=INFO

# --- storage ---
# CLAUDE_LB_DATA_DIR=~/.claude-lb
# CLAUDE_LB_DATABASE_URL=postgresql+asyncpg://user:pass@localhost/claudelb
CLAUDE_LB_REQUEST_LOG_RETENTION_DAYS=30

# --- routing ---
# capacity_weighted | round_robin | least_used | fill_first | single_account
CLAUDE_LB_ROUTING_STRATEGY=capacity_weighted
CLAUDE_LB_MAX_ATTEMPTS=3

# --- upstream ---
CLAUDE_LB_UPSTREAM_BASE_URL=https://api.anthropic.com
CLAUDE_LB_UPSTREAM_TIMEOUT_SECONDS=600

# --- security ---
# Require a clb_ key on proxy routes. Only set false on a loopback-only dev instance.
CLAUDE_LB_REQUIRE_API_KEY=true
# Fernet key encrypting upstream credentials. Generated into the data dir if unset.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CLAUDE_LB_SECRET_KEY=

CLAUDE_LB_DASHBOARD_ENABLED=true
